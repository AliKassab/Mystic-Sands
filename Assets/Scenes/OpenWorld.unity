  m_EditorClassIdentifier: 
  CurrentIDCounter: 17
  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":3}],"EditorInfo":{"isRoot":false,"xPos":588,"yPos":265},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"I
    do not know...","parentUIDs":[1],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":6}],"EditorInfo":{"isRoot":false,"xPos":839,"yPos":145},"ID":5,"ParamActions":[],"TMPFontGUID":null,"Text":"I
    will help you.","parentUIDs":[1],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":594,"yPos":22},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Peace
    be upon you again, merchant. I have been thinking about our conversation, and
    I believe I may have made my decision.","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":5},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":2}],"EditorInfo":{"isRoot":false,"xPos":592,"yPos":130},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"And
    peace be upon you, stranger. It seems you have something important to say.","parentUIDs":[0],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":574,"yPos":353},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"Fret
    not, I will be here if you change your mind.\r\n","parentUIDs":[2],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":7}],"EditorInfo":{"isRoot":false,"xPos":840,"yPos":220},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"May
    God bless you! I knew you would make the right decision. But you must begin by
    speaking with the writer.","parentUIDs":[5],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":8}],"EditorInfo":{"isRoot":false,"xPos":833,"yPos":329},"ID":7,"ParamActions":[],"TMPFontGUID":null,"Text":"The
    writer? Who is that?","parentUIDs":[6],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":11}],"EditorInfo":{"isRoot":false,"xPos":835,"yPos":443},"ID":8,"ParamActions":[],"TMPFontGUID":null,"Text":"The
    writer is a wise man who lives in the market here. He has a small stall in that
    corner, where he sells old books and scrolls. But what not everyone knows is
    that he keeps the stone.","parentUIDs":[7],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":12}],"EditorInfo":{"isRoot":false,"xPos":1071,"yPos":446},"ID":11,"ParamActions":[],"TMPFontGUID":null,"Text":"And
    will he give it to me? How can I prove to him that I am worthy of his trust?","parentUIDs":[8],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":13}],"EditorInfo":{"isRoot":false,"xPos":1074,"yPos":333},"ID":12,"ParamActions":[],"TMPFontGUID":null,"Text":"Speak
    to him honestly, and tell him that you are here to help us, to return the stone
    to its rightful place. His heart will know if you are sincere. Go to him; he
    is there in the corner under that red tent.","parentUIDs":[11],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":14}],"EditorInfo":{"isRoot":false,"xPos":1076,"yPos":224},"ID":13,"ParamActions":[],"TMPFontGUID":null,"Text":"I
    will go to him now. Thank you, merchant, for your guidance.","parentUIDs":[12],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":1077,"yPos":117},"ID":14,"ParamActions":[],"TMPFontGUID":null,"Text":"No
    thanks are needed. The writer awaits you, and every word you speak to him could
    be the beginning of restoring what is right.","parentUIDs":[13],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0}]}'
