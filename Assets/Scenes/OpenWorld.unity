  json: '{"Options":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":19}],"EditorInfo":{"isRoot":false,"xPos":737.5,"yPos":263},"ID":14,"ParamActions":[],"TMPFontGUID":null,"Text":"I
    do not know...","parentUIDs":[3],"SpeechUID":-1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":23}],"EditorInfo":{"isRoot":false,"xPos":459.5,"yPos":260},"ID":15,"ParamActions":[],"TMPFontGUID":null,"Text":"I
    will help you!","parentUIDs":[3],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":594,"yPos":21},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Peace
    be upon you, good sir. I have awakened from a long slumber, and everything seems
    strange. I want to return to my homeland, but first, I must understand what is
    happening.","parentUIDs":[],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":true,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0.1,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":2}],"EditorInfo":{"isRoot":false,"xPos":833,"yPos":23},"ID":1,"ParamActions":[],"TMPFontGUID":null,"Text":"And
    peace be upon you. Yes, the world has changed. You are not from here, are you?","parentUIDs":[0],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":true,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0.1,"Volume":1},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":3}],"EditorInfo":{"isRoot":false,"xPos":835.5,"yPos":124},"ID":2,"ParamActions":[],"TMPFontGUID":null,"Text":"Indeed,
    and I must understand what is happening. People are speaking Arabic, but something
    is missing.","parentUIDs":[1],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":true,"IconGUID":null,"Name":"The
    Stranger","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0.1,"Volume":1},{"Connections":[{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":15},{"__type":"EditableOptionConnection:#DialogueEditor","Conditions":[],"NodeUID":14}],"EditorInfo":{"isRoot":false,"xPos":591.5,"yPos":125},"ID":3,"ParamActions":[],"TMPFontGUID":null,"Text":"We
    are in an uprising to reclaim our language and identity. The enemies seized our
    fortress and replaced a stone representing our heritage with their own. We now
    have the original stone, and we must return it to the fortress.","parentUIDs":[2],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":true,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0.1,"Volume":1},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":872.5,"yPos":334},"ID":19,"ParamActions":[],"TMPFontGUID":null,"Text":"Fret
    not, I will be here if you change your mind.","parentUIDs":[14],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":364,"yPos":356},"ID":23,"ParamActions":[],"TMPFontGUID":null,"Text":"May
    God bless you! Speak with the writer, for he possesses the stone.","parentUIDs":[15],"AdvanceDialogueAutomatically":false,"AudioGUID":null,"AutoAdvanceShouldDisplayOption":false,"IconGUID":null,"Name":"Pottery
    merchant","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":1}]}'
