    Commander","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":369,"yPos":505},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"Think
