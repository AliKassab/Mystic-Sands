    I will do that.","parentUIDs":[1],"SpeechUID":-1}],"Parameters":[],"SpeechNodes":[{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":1}],"EditorInfo":{"isRoot":true,"xPos":592,"yPos":21},"ID":0,"ParamActions":[],"TMPFontGUID":null,"Text":"Peace
